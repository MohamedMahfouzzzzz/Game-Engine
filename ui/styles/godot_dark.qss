/* godot_dark.qss - Godot 4.6/4.7 Dark Editor Theme */
/* See full file in local branch feature/engine-evolution */

QMainWindow, QWidget {
    background-color: #1e1e1e;
    color: #dddddd;
    font-family: 'Segoe UI', 'Inter', 'Liberation Sans', sans-serif;
    font-size: 13px;
}
QMenuBar {
    background-color: #2b2b2b;
    color: #cccccc;
    border-bottom: 1px solid #111111;
    padding: 2px 4px;
}
QMenuBar::item { background-color: transparent; color: #cccccc; padding: 5px 10px; border-radius: 4px; }
QMenuBar::item:selected { background-color: #3c3c3c; color: #ffffff; }
QMenu { background-color: #2b2b2b; color: #cccccc; border: 1px solid #111; border-radius: 6px; padding: 4px 0; }
QMenu::item { padding: 6px 28px 6px 14px; border-radius: 3px; margin: 1px 4px; }
QMenu::item:selected { background-color: #4a6fa5; color: #ffffff; }
QMenu::separator { height: 1px; background-color: #3d3d3d; margin: 4px 10px; }
QToolBar { background-color: #2b2b2b; border-bottom: 1px solid #111; spacing: 3px; padding: 3px 6px; }
QToolButton { background-color: transparent; color: #cccccc; border: 1px solid transparent; border-radius: 4px; padding: 5px 9px; }
QToolButton:hover { background-color: #3c3c3c; border-color: #555; color: #fff; }
QToolButton:pressed { background-color: #4a6fa5; }
QStatusBar { background-color: #252525; color: #aaaaaa; border-top: 1px solid #111; padding: 3px 8px; }
QDockWidget::title { background-color: #252525; border-bottom: 1px solid #111; padding: 6px 10px; color: #aaaaaa; font-size: 12px; text-transform: uppercase; }
QTabBar::tab { background-color: #252525; color: #888; border: none; border-bottom: 2px solid transparent; padding: 8px 18px; }
QTabBar::tab:selected { background-color: #1a1a1a; color: #fff; border-bottom: 2px solid #4a6fa5; }
QTreeWidget, QTreeView { background-color: #1e1e1e; color: #cccccc; border: none; }
QTreeWidget::item:selected, QTreeView::item:selected { background-color: #3d5a80; color: #fff; }
QListWidget, QListView { background-color: #1e1e1e; color: #cccccc; border: none; }
QListWidget::item:selected { background-color: #3d5a80; color: #fff; }
QTableWidget, QTableView { background-color: #1e1e1e; color: #cccccc; border: none; gridline-color: #2d2d2d; }
QHeaderView::section { background-color: #252525; color: #aaaaaa; padding: 6px 8px; border: none; border-bottom: 1px solid #1a1a1a; }
QPushButton { background-color: #3c3c3c; color: #cccccc; border: 1px solid #555; border-radius: 4px; padding: 6px 16px; min-width: 70px; }
QPushButton:hover { background-color: #4a4a4a; color: #fff; }
QPushButton:default { background-color: #4a6fa5; border-color: #3a5f95; color: #fff; }
QPushButton#playButton { background-color: #2d5a27; color: #7ec87a; border: 1px solid #3d7a37; }
QPushButton#stopButton { background-color: #5a2727; color: #c87a7a; border: 1px solid #7a3737; }
QLineEdit, QTextEdit, QPlainTextEdit { background-color: #2a2a2a; color: #dddddd; border: 1px solid #444; border-radius: 4px; padding: 5px 8px; }
QLineEdit:focus { border-color: #4a6fa5; }
QComboBox { background-color: #2a2a2a; color: #dddddd; border: 1px solid #444; border-radius: 4px; padding: 5px 8px; }
QScrollBar:vertical { background-color: #1e1e1e; width: 10px; border: none; }
QScrollBar::handle:vertical { background-color: #4a4a4a; border-radius: 5px; min-height: 24px; margin: 1px 2px; }
QScrollBar:horizontal { background-color: #1e1e1e; height: 10px; border: none; }
QScrollBar::handle:horizontal { background-color: #4a4a4a; border-radius: 5px; min-width: 24px; }
QSplitter::handle { background-color: #111; }
QSplitter::handle:horizontal { width: 3px; }
QSplitter::handle:vertical { height: 3px; }
QLabel { color: #cccccc; background-color: transparent; }
QGroupBox { background-color: #222; color: #aaa; border: 1px solid #333; border-radius: 5px; margin-top: 14px; padding: 12px 10px 8px 10px; }
QProgressBar { background-color: #2a2a2a; border: 1px solid #444; border-radius: 4px; text-align: center; color: #cccccc; }
QProgressBar::chunk { background-color: #4a6fa5; border-radius: 3px; }
QToolTip { background-color: #1a1a1a; color: #dddddd; border: 1px solid #3d3d3d; border-radius: 4px; padding: 5px 8px; }
QLabel#uniqueNameBadge { background-color: #3d5a80; color: #aac8f0; border-radius: 3px; padding: 1px 5px; font-size: 11px; font-weight: 700; }
QPlainTextEdit#consoleOutput { background-color: #181818; color: #cccccc; font-family: 'Consolas', monospace; font-size: 12px; }
